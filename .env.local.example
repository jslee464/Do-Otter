# Supabase 연결 정보
# Supabase 대시보드 > Project Settings > API 에서 복사하세요.
#   - Project URL      → NEXT_PUBLIC_SUPABASE_URL
#   - anon public key  → NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# 이 파일을 복사해서 `.env.local` 로 저장하고 값을 채운 뒤 `npm run dev` 를 재시작하세요.
# (값을 채우지 않으면 앱은 자동으로 '데모 모드'(브라우저 로컬 저장)로 동작합니다.)

NEXT_PUBLIC_SUPABASE_URL=https://rjplvlodlkifqpisiyut.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PortOne(아임포트) 결제 — admin.portone.io
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_V2_API_SECRET=

# Google Calendar 연동 (서버 전용)
#  Google Cloud Console > APIs & Services 에서 발급
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
